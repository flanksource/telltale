{
  "type": "object",
  "properties": {
    "connection": {
      "type": "string",
      "title": "Connection",
      "description": "SQL Server connection reference"
    },
    "databases": {
      "type": "array",
      "title": "Databases",
      "description": "Database patterns with * wildcards and ! exclusions; empty selects the connected database",
      "items": {
        "type": "string"
      }
    },
    "minExecutions": {
      "type": "integer",
      "title": "Minimum executions",
      "format": "int32",
      "description": "Minimum interval executions to record"
    },
    "poll": {
      "type": "string",
      "title": "Poll",
      "description": "Poll interval such as 30s",
      "default": "30s"
    },
    "target": {
      "properties": {
        "agent": {
          "type": "string",
          "title": "Agent",
          "description": "Agent ID to observe"
        },
        "allowMutation": {
          "type": "boolean",
          "title": "Allow mutation",
          "description": "Allow probes to change runtime settings"
        },
        "pid": {
          "type": "integer",
          "title": "PID",
          "format": "int32",
          "description": "Process to observe"
        },
        "seam": {
          "type": "string",
          "title": "Seam",
          "description": "How the capture is armed (supported seams: [connection])",
          "enum": [
            "connection"
          ],
          "default": "connection"
        },
        "selector": {
          "type": "object",
          "title": "Selector",
          "description": "Agent resource attributes to match",
          "additionalProperties": {
            "type": "string"
          }
        },
        "wait": {
          "type": "boolean",
          "title": "Wait for agents",
          "description": "Wait for a matching agent to connect"
        }
      },
      "type": "object",
      "x-telltale-seams": [
        "connection"
      ]
    },
    "text": {
      "type": "array",
      "title": "Statement text",
      "description": "SQL text patterns with * wildcards and ! exclusions; bare values match substrings",
      "items": {
        "type": "string"
      }
    },
    "top": {
      "type": "integer",
      "title": "Top",
      "format": "int32",
      "description": "Maximum cost samples per poll ranked by interval CPU; defaults to 200",
      "default": 200
    }
  },
  "required": [
    "connection"
  ]
}
