{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "Executable name glob"
    },
    "tailBytes": {
      "type": "integer",
      "format": "int32",
      "description": "Maximum bytes of each output tail",
      "default": 4096
    },
    "target": {
      "properties": {
        "agent": {
          "type": "string",
          "title": "Agent",
          "description": "Agent ID to observe"
        },
        "allowMutation": {
          "type": "boolean",
          "title": "Allow mutation",
          "description": "Allow probes to change runtime settings"
        },
        "pid": {
          "type": "integer",
          "title": "PID",
          "format": "int32",
          "description": "Process to observe"
        },
        "seam": {
          "type": "string",
          "title": "Seam",
          "description": "How the capture is armed (supported seams: [self agent])",
          "enum": [
            "self",
            "agent"
          ],
          "default": "self"
        },
        "selector": {
          "type": "object",
          "title": "Selector",
          "description": "Agent resource attributes to match",
          "additionalProperties": {
            "type": "string"
          }
        },
        "wait": {
          "type": "boolean",
          "title": "Wait for agents",
          "description": "Wait for a matching agent to connect"
        }
      },
      "type": "object",
      "x-telltale-seams": [
        "self",
        "agent"
      ]
    }
  }
}
