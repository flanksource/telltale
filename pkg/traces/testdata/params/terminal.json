{
  "type": "object",
  "properties": {
    "command": {
      "type": "array",
      "title": "Command",
      "description": "Command line named in the cast's header",
      "items": {
        "type": "string"
      }
    },
    "height": {
      "type": "integer",
      "title": "Height",
      "format": "int32",
      "description": "Terminal height in cells",
      "default": 40
    },
    "maxBytes": {
      "type": "string",
      "title": "Max bytes",
      "description": "Most output recorded as events such as 4MiB",
      "default": "4MiB"
    },
    "snapshotInterval": {
      "type": "string",
      "title": "Snapshot interval",
      "description": "How often the settled screen is recorded such as 100ms",
      "default": "100ms"
    },
    "target": {
      "properties": {
        "agent": {
          "type": "string",
          "title": "Agent",
          "description": "Agent ID to observe"
        },
        "allowMutation": {
          "type": "boolean",
          "title": "Allow mutation",
          "description": "Allow probes to change runtime settings"
        },
        "pid": {
          "type": "integer",
          "title": "PID",
          "format": "int32",
          "description": "Process to observe"
        },
        "seam": {
          "type": "string",
          "title": "Seam",
          "description": "How the capture is armed (supported seams: [self])",
          "enum": [
            "self"
          ],
          "default": "self"
        },
        "selector": {
          "type": "object",
          "title": "Selector",
          "description": "Agent resource attributes to match",
          "additionalProperties": {
            "type": "string"
          }
        },
        "wait": {
          "type": "boolean",
          "title": "Wait for agents",
          "description": "Wait for a matching agent to connect"
        }
      },
      "type": "object",
      "x-telltale-seams": [
        "self"
      ]
    },
    "width": {
      "type": "integer",
      "title": "Width",
      "format": "int32",
      "description": "Terminal width in cells",
      "default": 120
    }
  }
}
